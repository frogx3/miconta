---
import { t } from '../i18n/messages';

interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const { locale } = Astro.locals;
---

<nav class="breadcrumb" aria-label={t(locale, 'nav.breadcrumb')}>
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
          {index < items.length - 1 && <span class="crumb-sep" aria-hidden="true">›</span>}
        </li>
      ))
    }
  </ol>
</nav>
