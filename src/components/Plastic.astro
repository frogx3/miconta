---
import { t } from '../i18n/messages';
import type { CardNetwork, CardTone } from '../lib/accounts/validation';

interface Props {
  kind: 'credit' | 'debit';
  isDigital: boolean;
  last4: string | null;
  tone: CardTone;
  network: CardNetwork | null;
  /** Uso de la línea de 0 a 1; sin dato no se dibuja la barra. */
  use?: number | null;
}

const { kind, isDigital, last4, tone, network, use = null } = Astro.props;
const { locale } = Astro.locals;
const type = t(locale, `card.kind.${kind}`);
const netName = network && network !== 'other' ? t(locale, `card.network.${network}`) : '';
---

<span class:list={['plastic', `tone-${tone}`, isDigital && 'is-digital']} role="img" aria-label={[type, isDigital ? t(locale, 'card.format.digital') : '', netName, last4 ? `···· ${last4}` : ''].filter(Boolean).join(' ')}>
  <span class="plastic-top" aria-hidden="true">
    <span class="plastic-kind">
      {type}
      {isDigital && <span class="plastic-tag">{t(locale, 'card.format.digital')}</span>}
    </span>
    {
      network === 'mastercard' && (
        <svg class="plastic-net" viewBox="0 0 48 30"><circle cx="17" cy="15" r="13" fill="#eb001b" /><circle cx="31" cy="15" r="13" fill="#f79e1b" /><path d="M24 4.1a13 13 0 0 1 0 21.8a13 13 0 0 1 0-21.8z" fill="#ff5f00" /></svg>
      )
    }
    {
      network === 'visa' && (
        <svg class="plastic-net" viewBox="0 0 60 22"><text x="30" y="18" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="21" font-weight="900" font-style="italic" fill="currentColor">VISA</text></svg>
      )
    }
    {
      network === 'amex' && (
        <svg class="plastic-net" viewBox="0 0 48 30"><rect width="48" height="30" rx="4" fill="#2e77bc" /><text x="24" y="19.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="11" font-weight="900" fill="#fff">AMEX</text></svg>
      )
    }
  </span>
  <span class="plastic-chip" aria-hidden="true"></span>
  <span class="plastic-n" aria-hidden="true">{last4 ? `•••• ${last4}` : '••••'}</span>
  {use != null && <span class="plastic-use" aria-hidden="true"><i style={`width:${Math.round(Math.min(1, Math.max(0, use)) * 100)}%`}></i></span>}
</span>
