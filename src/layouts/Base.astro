---
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import { t } from '../i18n/messages';

interface Props {
  title: string;
  /** Solo la landing se deja indexar; la app, el admin y el acceso no. */
  indexable?: boolean;
  /** Título completo, sin « · Don Bigo» (la landing). */
  fullTitle?: boolean;
  description?: string;
}

const { title, indexable = false, fullTitle = false, description } = Astro.props;
const { locale } = Astro.locals;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Don Bigo" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var choice = null;
        try { choice = localStorage.getItem('miconta-theme'); } catch (e) {}
        var dark = choice === 'dark' || (choice !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
      })();
    </script>
    {!indexable && <meta name="robots" content="noindex" />}
    {description && <meta name="description" content={description} />}
    <title>{fullTitle ? title : `${title} · ${t(locale, 'app.name')}`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skip.main')}</a>
    <slot />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
