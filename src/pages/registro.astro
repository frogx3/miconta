---
import AuthLayout from '../layouts/AuthLayout.astro';
import { t, messagesFor } from '../i18n/messages';
import { getDb, getSetupConfig, isSignupAllowedByConfig } from '../lib/auth';
import { isSignupOpen } from '../lib/auth/hooks';

const { locale } = Astro.locals;
const { open, firstUser } = await isSignupOpen(getDb(), isSignupAllowedByConfig());
// Solo quien reclama el sistema (primer usuario) necesita el código de configuración.
const setupRequired = firstUser && getSetupConfig().required;
const messages = messagesFor(locale, ['auth.']);
---

<AuthLayout
  title={t(locale, 'auth.signup.title')}
  heading={open ? t(locale, 'auth.signup.heading') : t(locale, 'auth.signup.closed')}
  lead={open ? t(locale, 'auth.signup.lead') : t(locale, 'auth.signup.closedHelp')}
>
  {
    open ? (
      <>
        {firstUser && <p class="notice">{t(locale, 'auth.signup.firstUser')}</p>}
        <div id="error" class="alert" role="alert" tabindex="-1" hidden />
        <form id="signup-form" data-messages={JSON.stringify(messages)} data-locale={locale} novalidate>
          <div class="field">
            <label for="name">{t(locale, 'auth.field.name')}</label>
            <input id="name" name="name" type="text" autocomplete="name" enterkeyhint="next" aria-describedby="name-error" required />
            <span class="field-error" id="name-error" />
          </div>
          <div class="field">
            <label for="email">{t(locale, 'auth.field.email')}</label>
            <input
              id="email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              enterkeyhint="next"
              aria-describedby="email-error"
              required
            />
            <span class="field-error" id="email-error" />
          </div>
          <div class="field">
            <label for="password">{t(locale, 'auth.field.password')}</label>
            <div class="password-wrap">
              <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" enterkeyhint={setupRequired ? 'next' : 'go'} aria-describedby="password-hint password-error" required />
              <button class="pw-toggle" type="button" data-pw-toggle="password" aria-pressed="false" aria-label={t(locale, 'auth.password.showLabel')}>
                {t(locale, 'auth.password.show')}
              </button>
            </div>
            <span class="hint" id="password-hint">{t(locale, 'auth.field.passwordHint')}</span>
            <span class="field-error" id="password-error" />
          </div>
          {setupRequired && (
            <div class="field">
              <label for="setupCode">{t(locale, 'auth.field.setupCode')}</label>
              <input id="setupCode" name="setupCode" type="password" autocomplete="off" enterkeyhint="go" aria-describedby="setupCode-hint setupCode-error" required />
              <span class="hint" id="setupCode-hint">{t(locale, 'auth.field.setupCodeHint')}</span>
              <span class="field-error" id="setupCode-error" />
            </div>
          )}
          <button class="btn" type="submit">
            {t(locale, 'auth.signup.submit')}
          </button>
        </form>
      </>
    ) : (
      <a class="btn btn-link" href="/login">{t(locale, 'auth.signup.loginLink')}</a>
    )
  }
  {
    open && (
      <p class="switch">
        {t(locale, 'auth.signup.haveAccount')} <a href="/login">{t(locale, 'auth.signup.loginLink')}</a>
      </p>
    )
  }
</AuthLayout>

<script>
  import { authClient } from '../lib/auth/client';
  import { authErrorKey } from '../lib/auth/errors';
  import { clearAlert, clearOnInput, focusFirstOnDesktop, initPasswordToggles, setBusy, showAlert, validateRequired, type Messages } from '../scripts/auth-form';

  const form = document.querySelector<HTMLFormElement>('#signup-form');
  if (form) {
    const errorBox = document.querySelector<HTMLElement>('#error')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const name = form.querySelector<HTMLInputElement>('#name')!;
    const email = form.querySelector<HTMLInputElement>('#email')!;
    const password = form.querySelector<HTMLInputElement>('#password')!;
    const setupCodeInput = form.querySelector<HTMLInputElement>('#setupCode');
    const messages = JSON.parse(form.dataset.messages!) as Messages;
    const idleText = button.textContent!.trim();

    initPasswordToggles(messages);
    clearOnInput(form);
    focusFirstOnDesktop(name);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearAlert(errorBox);

      const invalid = validateRequired([
        { input: name, message: messages['auth.error.nameRequired']! },
        { input: email, message: messages['auth.error.emailRequired']!, test: (value) => /^\S+@\S+\.\S+$/.test(value) },
        { input: password, message: messages['auth.error.passwordTooShort']!, test: (value) => value.length >= 10 },
        { input: setupCodeInput, message: messages['auth.error.setupRequired']! },
      ]);
      if (invalid) {
        invalid.focus();
        return;
      }

      setBusy(form, button, true, messages['auth.working']!, idleText);
      const setupCode = setupCodeInput?.value ?? '';
      const { error } = await authClient.signUp.email({
        name: name.value.trim(),
        email: email.value.trim(),
        password: password.value,
        locale: form.dataset.locale,
        // El código viaja en una cabecera, no en el cuerpo: no se guarda como dato del usuario.
        ...(setupCode ? { fetchOptions: { headers: { 'x-setup-code': setupCode } } } : {}),
      });

      if (error) {
        setBusy(form, button, false, messages['auth.working']!, idleText);
        showAlert(errorBox, messages['auth.error.label']!, messages[authErrorKey(error)] ?? messages['auth.error.generic']!);
        return;
      }
      location.assign('/app');
    });
  }
</script>
