---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { t, type MessageKey } from '../../i18n/messages';
import { getAuth } from '../../lib/auth';
import { SUPPORTED_LOCALES } from '../../lib/locale';
import { getDb } from '../../lib/auth';
import { formatDate } from '../../lib/date-format';
import { DELETION_GRACE_DAYS, listPendingDeletion } from '../../lib/me/lifecycle';

const { user, locale } = Astro.locals;
if (user?.role !== 'admin') return Astro.redirect('/app');

const { users: allUsers } = await getAuth().api.listUsers({
  query: { limit: 200, sortBy: 'createdAt', sortDirection: 'asc' },
  headers: Astro.request.headers,
});
// Las cuentas borradas por su dueño (stand-by) o ya purgadas no aparecen en la lista principal.
const pendingDeletion = await listPendingDeletion(getDb());
const users = allUsers.filter((row) => !(row as { deletedAt?: unknown }).deletedAt);
const purgeOn = (date: Date) => new Date(date.getTime() + DELETION_GRACE_DAYS * 86_400_000).toISOString().slice(0, 10);

const keys: MessageKey[] = ['admin.deletion.confirmPurge', 'admin.deletion.error', 'auth.working', 'admin.create.submit', 'admin.create.done', 'admin.error.generic', 'auth.error.userExists', 'auth.error.passwordTooShort', 'auth.error.invalidEmail', 'admin.create.invited', 'admin.invite.emailFailed'];
const messages = Object.fromEntries(keys.map((key) => [key, t(locale, key)]));
---

<AdminLayout title={t(locale, 'admin.title')}>
  <h1>{t(locale, 'admin.users')}</h1>
  <p class="hint">{t(locale, 'admin.hint')}</p>

  <section class="card">
    <table>
<caption class="sr-only">{t(locale, 'table.sr.users')}</caption>
      <thead>
        <tr>
          <th scope="col">{t(locale, 'admin.col.name')}</th>
          <th scope="col">{t(locale, 'admin.col.email')}</th>
          <th scope="col">{t(locale, 'admin.col.type')}</th>
          <th scope="col">{t(locale, 'admin.col.status')}</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        {
          users.map((row) => (
            <tr>
              <td>{row.name}</td>
              <td>{row.email}</td>
              <td>{t(locale, row.role === 'admin' ? 'admin.type.admin' : 'admin.type.user')}</td>
              <td>
                <span class:list={['badge', row.banned && 'badge-off']}>
                  {t(locale, row.banned ? 'admin.status.suspended' : 'admin.status.active')}
                </span>
              </td>
              <td>
                <a href={`/admin/users/${row.id}`}>{t(locale, 'admin.edit.link')}</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  {
    pendingDeletion.length > 0 && (
      <section class="card" id="pending-deletion">
        <h2>{t(locale, 'admin.deletion.title')}</h2>
        <p class="hint">{t(locale, 'admin.deletion.hint', { days: String(DELETION_GRACE_DAYS) })}</p>
        <div id="deletion-error" class="alert" role="alert" hidden></div>
        <ul class="pending-invites">
          {pendingDeletion.map((row) => (
            <li data-user={row.id} data-email={row.email}>
              <span>
                <strong>{row.name}</strong> <span class="muted">{row.email}</span>
                <br />
                <span class="muted">{t(locale, 'admin.deletion.when', { requested: formatDate(row.deletedAt.toISOString().slice(0, 10), locale), purge: formatDate(purgeOn(row.deletedAt), locale) })}</span>
              </span>
              <span class="row-actions">
                <button type="button" class="btn btn-ghost btn-small" data-deletion="POST">{t(locale, 'admin.deletion.restore')}</button>
                <button type="button" class="btn btn-danger btn-small" data-deletion="DELETE">{t(locale, 'admin.deletion.purge')}</button>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="card">
    <h2>{t(locale, 'admin.create.title')}</h2>
    <div id="error" class="alert" role="alert" hidden></div>
    <div id="done" class="alert ok" role="status" hidden></div>
    <form id="create-form" class="form-grid" data-messages={JSON.stringify(messages)} novalidate>
      <div class="field">
        <label for="name">{t(locale, 'auth.field.name')}</label>
        <input id="name" name="name" type="text" autocomplete="off" required />
      </div>
      <div class="field">
        <label for="email">{t(locale, 'auth.field.email')}</label>
        <input id="email" name="email" type="email" autocomplete="off" required />
      </div>
      <div class="field">
        <label for="password">{t(locale, 'auth.field.password')}</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" />
        <span class="hint">{t(locale, 'admin.create.passwordOptional')}</span>
      </div>
      <div class="field">
        <label for="role">{t(locale, 'admin.create.type')}</label>
        <select id="role" name="role">
          <option value="user" selected>{t(locale, 'admin.type.user')}</option>
          <option value="admin">{t(locale, 'admin.type.admin')}</option>
        </select>
      </div>
      <div class="field">
        <label for="locale">{t(locale, 'admin.create.locale')}</label>
        <select id="locale" name="locale">
          {SUPPORTED_LOCALES.map((code) => <option value={code} selected={code === 'es-MX'}>{t(locale, `locale.${code}`)}</option>)}
        </select>
      </div>
      <div class="form-actions">
        <button class="btn" type="submit">{t(locale, 'admin.create.submit')}</button>
      </div>
    </form>
  </section>
</AdminLayout>

<script>
  import { authClient } from '../../lib/auth/client';
  import { authErrorKey } from '../../lib/auth/errors';

  const form = document.querySelector<HTMLFormElement>('#create-form')!;
  const errorBox = document.querySelector<HTMLElement>('#error')!;
  const doneBox = document.querySelector<HTMLElement>('#done')!;
  const button = form.querySelector<HTMLButtonElement>('button')!;
  const messages = JSON.parse(form.dataset.messages!) as Record<string, string>;

  // Cuentas por eliminar: restablecer o eliminar para siempre (esta última pide escribir el correo).
  document.querySelectorAll<HTMLButtonElement>('#pending-deletion [data-deletion]').forEach((button) =>
    button.addEventListener('click', async () => {
      const row = button.closest<HTMLElement>('li')!;
      const box = document.querySelector<HTMLElement>('#deletion-error')!;
      const method = button.dataset.deletion!;
      if (method === 'DELETE' && window.prompt(messages['admin.deletion.confirmPurge']!.replace('{email}', row.dataset.email!))?.trim().toLowerCase() !== row.dataset.email!.toLowerCase()) return;
      button.disabled = true;
      const response = await fetch(`/api/admin/users/${row.dataset.user}/deletion`, { method, headers: { 'content-type': 'application/json' }, body: '{}' }).catch(() => null);
      if (response?.ok) return location.reload();
      button.disabled = false;
      box.textContent = messages['admin.deletion.error']!;
      box.hidden = false;
    }),
  );

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.hidden = true;
    doneBox.hidden = true;
    button.disabled = true;
    button.textContent = messages['auth.working']!;

    const data = new FormData(form);
    const typed = String(data.get('password') ?? '');
    // Sin contraseña se invita por correo: la cuenta nace con una aleatoria que nadie conoce y el código la reemplaza.
    const random = () => btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32))));
    const { data: created, error } = await authClient.admin.createUser({
      name: String(data.get('name')),
      email: String(data.get('email')),
      password: typed || random(),
      role: data.get('role') === 'admin' ? 'admin' : 'user',
      data: { locale: String(data.get('locale')) },
    });

    button.disabled = false;
    button.textContent = messages['admin.create.submit']!;
    if (error) {
      const key = authErrorKey(error);
      errorBox.textContent = messages[key] ?? messages['admin.error.generic']!;
      if (key === 'auth.error.generic') errorBox.textContent = messages['admin.error.generic']!;
      errorBox.hidden = false;
      return;
    }
    if (!typed) {
      const sent = await fetch(`/api/admin/users/${created.user.id}/access-code`, { method: 'POST' }).catch(() => null);
      if (!sent?.ok) {
        errorBox.textContent = messages['admin.invite.emailFailed']!;
        errorBox.hidden = false;
        return;
      }
    }
    doneBox.textContent = typed ? messages['admin.create.done']! : messages['admin.create.invited']!.replace('{email}', created.user.email);
    doneBox.hidden = false;
    setTimeout(() => location.reload(), 600);
  });
</script>
