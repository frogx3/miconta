---
import AuthLayout from '../layouts/AuthLayout.astro';
import { messagesFor, t } from '../i18n/messages';

const { locale } = Astro.locals;
const code = Astro.url.searchParams.get('codigo') ?? '';
const messages = messagesFor(locale, ['auth.', 'access.error.']);
---

<AuthLayout title={t(locale, 'access.title')} heading={t(locale, 'access.heading')} lead={t(locale, 'access.lead')}>
  <div id="error" class="alert" role="alert" tabindex="-1" hidden></div>
  <form id="access-form" data-messages={JSON.stringify(messages)} novalidate>
    <div class="field">
      <label for="code">{t(locale, 'access.field.code')}</label>
      <input id="code" name="code" type="text" value={code} autocomplete="one-time-code" autocapitalize="characters" autocorrect="off" spellcheck="false" enterkeyhint="next" aria-describedby="code-error" required />
      <span class="field-error" id="code-error"></span>
    </div>
    <div class="field">
      <label for="password">{t(locale, 'auth.field.password')}</label>
      <div class="password-wrap">
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" enterkeyhint="next" aria-describedby="password-hint password-error" required />
        <button class="pw-toggle" type="button" data-pw-toggle="password" aria-pressed="false" aria-label={t(locale, 'auth.password.showLabel')}>
          {t(locale, 'auth.password.show')}
        </button>
      </div>
      <span class="hint" id="password-hint">{t(locale, 'auth.field.passwordHint')}</span>
      <span class="field-error" id="password-error"></span>
    </div>
    <div class="field">
      <label for="confirm">{t(locale, 'access.field.confirm')}</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" enterkeyhint="go" aria-describedby="confirm-error" required />
      <span class="field-error" id="confirm-error"></span>
    </div>
    <button class="btn" type="submit">{t(locale, 'access.submit')}</button>
  </form>
  <p class="switch"><a href="/login">{t(locale, 'auth.signup.loginLink')}</a></p>
</AuthLayout>

<script>
  import { clearAlert, clearOnInput, focusFirstOnDesktop, initPasswordToggles, setBusy, showAlert, validateRequired, type Messages } from '../scripts/auth-form';

  const form = document.querySelector<HTMLFormElement>('#access-form')!;
  const errorBox = document.querySelector<HTMLElement>('#error')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const code = form.querySelector<HTMLInputElement>('#code')!;
  const password = form.querySelector<HTMLInputElement>('#password')!;
  const confirm = form.querySelector<HTMLInputElement>('#confirm')!;
  const messages = JSON.parse(form.dataset.messages!) as Messages;
  const idleText = button.textContent!.trim();

  initPasswordToggles(messages);
  clearOnInput(form);
  focusFirstOnDesktop(code.value ? password : code);

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearAlert(errorBox);
    const invalid = validateRequired([
      { input: code, message: messages['access.error.codeRequired']! },
      { input: password, message: messages['auth.error.passwordTooShort']!, test: (value) => value.length >= 10 },
      { input: confirm, message: messages['access.error.mismatch']!, test: (value) => value === password.value },
    ]);
    if (invalid) return invalid.focus();

    setBusy(form, button, true, messages['auth.working']!, idleText);
    const response = await fetch('/api/access', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code: code.value, password: password.value }) }).catch(() => null);
    const result = (await response?.json().catch(() => null)) as { next?: string; code?: string } | null;
    if (response?.ok && result?.next) return location.assign(result.next);
    setBusy(form, button, false, messages['auth.working']!, idleText);
    const key = result?.code === 'CODE_INVALID' ? 'access.error.invalid' : result?.code === 'PASSWORD_TOO_SHORT' ? 'auth.error.passwordTooShort' : 'auth.error.generic';
    showAlert(errorBox, messages['auth.error.label']!, messages[key]!);
  });
</script>
