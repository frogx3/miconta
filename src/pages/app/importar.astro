---
import AppLayout from '../../layouts/AppLayout.astro';
import Help from '../../components/Help.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ImportSteps from '../../components/ImportSteps.astro';
import { messagesFor, t } from '../../i18n/messages';
import { getDb } from '../../lib/auth';
import { listAccounts } from '../../lib/accounts/repo';
import { importCurrency } from '../../lib/import/service';

const { workspace, locale } = Astro.locals;
if (!workspace) return Astro.redirect('/login');
if (workspace.role === 'viewer') return Astro.redirect('/app');

const accounts = (await listAccounts(getDb(), workspace.id)).map((account) => {
  const { currency, mixed } = importCurrency(account, workspace.defaultCurrency);
  return { id: account.id, name: account.name, currency, mixedCurrencies: mixed };
});
const requested = Astro.url.searchParams.get('cuenta');
const initialAccount = accounts.find((account) => account.id === requested)?.id ?? accounts[0]?.id ?? null;
// Primero se elige el formato; el CSV sigue aquí y el PDF en su propia página.
const csv = Astro.url.searchParams.get('formato') === 'csv';
const withAccount = (path: string) => (requested ? `${path}${path.includes('?') ? '&' : '?'}cuenta=${encodeURIComponent(requested)}` : path);

const config = {
  locale,
  initialAccount,
  accounts,
  messages: messagesFor(locale, ['import.', 'validation.', 'common.']),
};
---

<AppLayout title={t(locale, 'import.title')} active="import">
  {csv && <Breadcrumb items={[{ label: t(locale, 'import.title'), href: withAccount('/app/importar') }, { label: t(locale, 'import.option.csv') }]} />}
  <h1>{t(locale, csv ? 'import.option.csv' : 'import.title')}<Help topic="import.title" /></h1>
  <p class="hint">{t(locale, csv ? 'import.intro' : 'import.choose.intro')}</p>
  <p><a class="touch-link" href="/app/importar/historial">{t(locale, 'import.history')}</a></p>

  {
    !csv ? (
      <ul class="import-formats" aria-label={t(locale, 'import.choose')}>
        <li>
          <a class="import-format" href={withAccount('/app/importar?formato=csv')}>
            <span class="import-format-icon" aria-hidden="true"><Icon name="file" size={24} /></span>
            <strong>{t(locale, 'import.option.csv')}</strong>
            <span class="muted">{t(locale, 'import.option.csv.hint')}</span>
            <em>{t(locale, 'import.option.csv.more')}</em>
          </a>
        </li>
        <li>
          <a class="import-format" href={withAccount('/app/importar/pdf')}>
            <span class="import-format-icon" aria-hidden="true"><Icon name="file-check" size={24} /></span>
            <strong>{t(locale, 'import.option.pdf')}</strong>
            <span class="muted">{t(locale, 'import.option.pdf.hint')}</span>
            <em>{t(locale, 'import.option.pdf.more')}</em>
          </a>
        </li>
      </ul>
    ) : accounts.length === 0 ? (
      <section class="card">
        <p class="empty">{t(locale, 'import.noAccounts')}</p>
        <a class="btn btn-link" href="/app/cuentas/nueva?next=importar">
          {t(locale, 'import.createAccount')}
        </a>
      </section>
    ) : (
      <div id="import-app" data-config={JSON.stringify(config)}>
        <ImportSteps
          label={t(locale, 'import.steps')}
          steps={(['file', 'columns', 'review', 'done'] as const).map((step) => ({ label: t(locale, `import.step.${step}`), hint: t(locale, `import.step.${step}.hint`) }))}
        />
        <section class="card" id="step-upload">
          <div id="upload-error" class="alert" role="alert" hidden></div>
          <form id="upload-form" class="form-grid" novalidate>
            <div class="field">
              <label for="account">{t(locale, 'import.account')}</label>
              <select id="account" name="account">
                {accounts.map((account) => (
                  <option value={account.id} selected={account.id === initialAccount}>
                    {account.name} · {account.currency}
                  </option>
                ))}
              </select>
            </div>
            <label class="import-drop" id="file-drop">
              <input id="file" class="file-input" name="file" type="file" accept=".csv,text/csv,.txt" required aria-label={t(locale, 'import.file')} />
              <span class="import-drop-icon" aria-hidden="true"><Icon name="upload" size={26} /></span>
              <strong>{t(locale, 'import.drop')}</strong>
              <span class="muted">{t(locale, 'import.drop.or')}</span>
              <span class="import-file-name" id="file-name" data-none={t(locale, 'import.file.none')}>{t(locale, 'import.file.none')}</span>
            </label>
            <p class="import-tip">
              {t(locale, 'import.template.hint')}<br />
              <a class="touch-link" href="/plantillas/movimientos.csv" download="plantilla-don-bigo.csv"><Icon name="download" size={18} /> {t(locale, 'import.template')}</a>
            </p>
            <div class="form-actions">
              <button class="btn" type="submit">{t(locale, 'import.analyze')}</button>
            </div>
          </form>
        </section>

        <div id="step-review" hidden>
          <section class="card" id="summary"></section>
          <section class="card" id="mapping-card"></section>
          <section class="card" id="matches-card" hidden></section>
          <section class="card" id="missing-card" hidden></section>
          <section class="card" id="cards-card" hidden></section>
          <section class="card" id="movements-card"></section>
          <section class="card" id="confirm-card"></section>
        </div>

        <section class="card" id="step-done" hidden></section>
      </div>
    )
  }
</AppLayout>

<script>
  import '../../scripts/import-wizard';
  import { bindDrop } from '../../scripts/import-ui';

  const input = document.querySelector<HTMLInputElement>('#file');
  const name = document.querySelector<HTMLElement>('#file-name');
  const drop = document.querySelector<HTMLElement>('#file-drop');
  if (drop && input) bindDrop(drop, input);
  input?.addEventListener('change', () => {
    if (name) name.textContent = input.files?.[0]?.name ?? name.dataset.none ?? '';
  });
</script>
