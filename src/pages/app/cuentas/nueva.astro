---
import AppLayout from '../../../layouts/AppLayout.astro';
import AccountForm from '../../../components/AccountForm.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { t } from '../../../i18n/messages';

const { workspace, locale } = Astro.locals;
if (!workspace) return Astro.redirect('/login');
if (workspace.role === 'viewer') return Astro.redirect('/app/cuentas');
---

<AppLayout title={t(locale, 'account.create.title')} active="accounts">
  <Breadcrumb items={[{ label: t(locale, 'accounts.title'), href: '/app/cuentas' }, { label: t(locale, 'account.create.title') }]} />
  <h1>{t(locale, 'account.create.title')}</h1>
  <p class="lead">{t(locale, 'account.new.lead')}</p>
  <section class="card measure">
    <AccountForm mode="create" next={Astro.url.searchParams.get('next') === 'importar' ? 'importar' : undefined} />
  </section>
</AppLayout>
