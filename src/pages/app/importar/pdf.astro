---
import AppLayout from '../../../layouts/AppLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Icon from '../../../components/Icon.astro';
import ImportSteps from '../../../components/ImportSteps.astro';
import { messagesFor, t } from '../../../i18n/messages';
import { getDb } from '../../../lib/auth';
import { listAccounts } from '../../../lib/accounts/repo';

const { workspace, locale } = Astro.locals;
if (!workspace) return Astro.redirect('/login');

const accounts = (await listAccounts(getDb(), workspace.id)).map((account) => ({
  id: account.id,
  name: account.name,
  currency: account.cards.find((card) => card.kind === 'credit')?.currency ?? workspace.defaultCurrency,
}));
const requested = Astro.url.searchParams.get('cuenta');
const initialAccount = accounts.find((account) => account.id === requested)?.id ?? accounts[0]?.id ?? '';
const config = { locale, accounts, messages: messagesFor(locale, ['statement.', 'common.']) };
---

<AppLayout title={t(locale, 'statement.pdfTitle')} active="import">
  <Breadcrumb items={[{ label: t(locale, 'import.title'), href: '/app/importar' }, { label: t(locale, 'statement.pdfTitle') }]} />
  <h1>{t(locale, 'statement.pdfTitle')}</h1>
  <p class="hint">{t(locale, 'statement.intro')}</p>

  {
    accounts.length === 0 ? (
      <section class="card">
        <p class="empty">{t(locale, 'import.noAccounts')}</p>
      </section>
    ) : (
      <div id="statement-app" data-config={JSON.stringify(config)}>
        <ImportSteps
          label={t(locale, 'import.steps')}
          steps={(['file', 'tables', 'diff', 'done'] as const).map((step) => ({ label: t(locale, `statement.step.${step}`), hint: t(locale, `statement.step.${step}.hint`) }))}
        />
        <section class="card">
          <div id="statement-error" class="alert" role="alert" hidden></div>
          <form id="statement-upload" class="form-grid" novalidate>
            <div class="field">
              <label for="statement-account">{t(locale, 'import.account')}</label>
              <select id="statement-account">
                {accounts.map((account) => (
                  <option value={account.id} selected={account.id === initialAccount}>
                    {account.name}
                  </option>
                ))}
              </select>
            </div>
            <label class="import-drop" id="statement-drop">
              <input id="statement-file" class="file-input" type="file" accept=".pdf,application/pdf" required aria-label={t(locale, 'statement.file')} />
              <span class="import-drop-icon" aria-hidden="true"><Icon name="upload" size={26} /></span>
              <strong>{t(locale, 'statement.drop')}</strong>
              <span class="muted">{t(locale, 'import.drop.or')}</span>
              <span class="import-file-name" id="statement-file-name">{t(locale, 'import.file.none')}</span>
            </label>
            <div class="field narrow" id="statement-password-field" hidden>
              <label for="statement-password">{t(locale, 'statement.password')}</label>
              <input id="statement-password" type="password" autocomplete="off" />
            </div>
            <p class="hint">{t(locale, 'statement.privacy')}</p>
            <div class="form-actions">
              <button class="btn" type="submit">{t(locale, 'statement.read')}</button>
            </div>
          </form>
        </section>

        <div id="statement-tables" hidden></div>
        <div id="statement-review" hidden></div>
        <div id="statement-result" hidden></div>
      </div>
    )
  }
</AppLayout>

<script>
  import '../../../scripts/statement-pdf';
</script>
