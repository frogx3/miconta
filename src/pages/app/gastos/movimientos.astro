---
import AppLayout from '../../../layouts/AppLayout.astro';
import SpendingTabs from '../../../components/SpendingTabs.astro';
import { messagesFor, t } from '../../../i18n/messages';
import FilterChip from '../../../components/FilterChip.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { listAccounts } from '../../../lib/accounts/repo';
import { cardDisplay } from '../../../lib/accounts/format';
import { and, eq } from 'drizzle-orm';
import { importBatches } from '../../../db/schema';
import { getDb } from '../../../lib/auth';
import { formatDate, formatMonth, formatMonthLong, todayISO } from '../../../lib/date-format';
import { formatMinor, toInputString } from '../../../lib/money-format';
import { groupedMemberKeys, paymentGroups } from '../../../lib/spending/groups';
import { isAnt, isFinance, isMonth, isSpend, monthBounds, thresholdFor } from '../../../lib/spending/analysis';
import { getWorkspaceSettings, listCategories, listCutoffs, listMovements, movementMonths } from '../../../lib/spending/repo';
import { realCuts, sinceLastCut } from '../../../lib/spending/statement';

const { workspace, locale } = Astro.locals;
if (!workspace) return Astro.redirect('/login');

const db = getDb();
const today = todayISO();
const params = Astro.url.searchParams;
// `a:<id>` = toda una cuenta; `c:<id>` = una tarjeta.
const scope = params.get('filtro') ?? '';
const accountFilter = scope.startsWith('a:') ? scope.slice(2) : '';
const cardFilter = scope.startsWith('c:') ? scope.slice(2) : '';
const categoryFilter = params.get('categoria') ?? '';
const q = (params.get('q') ?? '').slice(0, 60);
// `lote` = solo los movimientos de una carga de CSV (se llega desde el final de la importación).
const [batch] = params.get('lote')
  ? await db.select({ id: importBatches.id, fileName: importBatches.fileName }).from(importBatches).where(and(eq(importBatches.id, params.get('lote')!), eq(importBatches.workspaceId, workspace.id))).limit(1)
  : [];
const type = ['hormiga', 'gastos', 'planes', 'intereses', 'abonos'].includes(params.get('tipo') ?? '') ? params.get('tipo')! : 'todos';

const [accounts, categories, settings, months] = await Promise.all([
  listAccounts(db, workspace.id, true),
  listCategories(db, workspace.id),
  getWorkspaceSettings(db, workspace.id),
  movementMonths(db, workspace.id),
]);
const scopedAccount = accounts.find((account) => account.id === accountFilter || account.cards.some((card) => card.id === cardFilter));
const scopedCard = scopedAccount?.cards.find((card) => card.id === cardFilter);

// Periodo: un corte real de la cuenta elegida, lo que va desde su último corte, un mes natural o todo el historial.
// Valores de `mes`: `corte:YYYY-MM` (corte real, nombrado por el mes en que cierra), `corte:actual` (desde el último corte),
// `YYYY-MM` (mes natural) o `todo`; el antiguo `corte` (+ `&corte=YYYY-MM`) se sigue entendiendo.
// Los cortes solo existen cuando hay una cuenta o tarjeta elegida y son los que se capturaron (al cargar el CSV, en el
// historial de cargas o en la vista de corte): nunca se estiman con el día de corte, porque los bancos lo mueven.
// Las dos tarjetas de una cuenta (física y digital) comparten corte.
const creditCard = scopedAccount?.cards.find((card) => card.kind === 'credit' && card.cutoffDay !== null && !card.archivedAt);
const cuts = scopedAccount ? realCuts(await listCutoffs(db, workspace.id, scopedAccount.id), creditCard?.cutoffDay ?? null, creditCard?.paymentDueDay ?? null) : [];
const since = sinceLastCut(cuts);
// Cortes a los que se puede contabilizar un movimiento a mano (solo con una cuenta o tarjeta elegida), del más reciente al más antiguo.
const cutChoices = scopedAccount ? [...cuts].reverse().map((cut) => ({ month: cut.month, label: formatMonthLong(cut.month, locale) })) : [];
const requested = params.get('mes') ?? (batch ? 'todo' : since ? 'corte:actual' : 'todo');
const wanted = requested === 'corte' ? (isMonth(params.get('corte')) ? `corte:${params.get('corte')}` : 'corte:actual') : requested;
const selectedCut = wanted.startsWith('corte:') ? cuts.find((cut) => `corte:${cut.month}` === wanted) : undefined;
const period = isMonth(wanted) || wanted === 'todo' ? wanted : wanted === 'corte:actual' && since ? 'actual' : selectedCut ? 'cut' : 'todo';

let bounds = { from: '0000-01-01', to: '9999-12-31' };
// Con un corte, además del rango de fechas cuentan las asignaciones manuales (un movimiento puede contabilizarse en otro corte).
let cutScope: { month: string | null; from: string; to: string } | undefined;
let periodNote = t(locale, 'movements.range.all');
if (isMonth(period)) {
  bounds = monthBounds(period);
  periodNote = formatMonth(period, locale);
} else if (period === 'actual' && since) {
  bounds = { from: since.from, to: '9999-12-31' };
  cutScope = { month: null, from: since.from, to: '9999-12-31' };
  periodNote = `${t(locale, 'movements.period.sinceLast')} · ${t(locale, 'movements.period.from', { from: formatDate(since.from, locale) })}`;
} else if (period === 'cut' && selectedCut) {
  bounds = { from: selectedCut.from, to: selectedCut.to };
  cutScope = { month: selectedCut.month, from: selectedCut.from, to: selectedCut.to };
  periodNote = `${t(locale, 'movements.period.cutoffName', { month: formatMonthLong(selectedCut.month, locale) })} · ${t(locale, 'statement.period', { from: formatDate(selectedCut.from, locale), to: formatDate(selectedCut.to, locale) })}`;
}
const list = await listMovements(db, workspace.id, { fromDate: bounds.from, toDate: bounds.to, cut: cutScope, cardId: cardFilter || undefined, accountId: accountFilter || undefined, categoryId: categoryFilter || undefined, q: q || undefined, batchId: batch?.id });
const thresholdOf = (currency: string) => thresholdFor(currency, { currency: settings.currency, thresholdMinor: settings.thresholdMinor });
const scopeLabel = scopedAccount ? (scopedCard ? cardDisplay({ accountName: scopedAccount.name, last4: scopedCard.last4, label: scopedCard.label }) : scopedAccount.name) : '';
// Pagos a meses con intereses: el "pago requerido", los intereses y el IVA comparten referencia y se muestran como uno.
const groups = paymentGroups(list.map((row) => ({ key: row.id, cardKey: row.cardId, reference: row.reference, descriptionNorm: row.descriptionNorm, chargeMinor: row.chargeMinor, creditMinor: row.creditMinor })));
const hiddenInGroup = groupedMemberKeys(groups);
const rowById = new Map(list.map((row) => [row.id, row]));
const rows = list.filter((row) => !hiddenInGroup.has(row.id)).filter((row) => {
  if (type === 'intereses' && groups.has(row.id)) return true;
  if (type === 'hormiga') return isAnt(row, thresholdOf(row.currency));
  if (type === 'gastos') return isSpend(row);
  if (type === 'planes') return row.planId !== null && row.chargeMinor > 0;
  if (type === 'intereses') return isFinance(row);
  if (type === 'abonos') return row.creditMinor > 0;
  return true;
});

const byId = new Map(categories.map((category) => [category.id, category]));

// Orden de la tabla (`orden` + `dir`): se aplica sobre lo que se muestra; por defecto, la fecha más reciente primero.
const SORT_COLUMNS = ['fecha', 'descripcion', 'monto', 'tarjeta', 'categoria'] as const;
type SortColumn = (typeof SORT_COLUMNS)[number];
const sortBy: SortColumn = (SORT_COLUMNS as readonly string[]).includes(params.get('orden') ?? '') ? (params.get('orden') as SortColumn) : 'fecha';
const sortDir: 'asc' | 'desc' = params.get('dir') === 'asc' ? 'asc' : params.get('dir') === 'desc' ? 'desc' : sortBy === 'fecha' ? 'desc' : 'asc';
const sortKey = (row: (typeof rows)[number]): string | number => {
  const group = groups.get(row.id);
  if (sortBy === 'fecha') return row.date;
  if (sortBy === 'descripcion') return row.descriptionNorm;
  if (sortBy === 'monto') return row.chargeMinor > 0 ? (group?.totalMinor ?? row.chargeMinor) : -row.creditMinor;
  if (sortBy === 'tarjeta') return `${row.accountName} ${row.last4 ?? ''}`.toLowerCase();
  return row.categoryId ? (byId.get(row.categoryId)?.name.toLowerCase() ?? '') : '';
};
const sortedRows = [...rows].sort((a, b) => {
  const left = sortKey(a);
  const right = sortKey(b);
  // Sin categoría siempre al final, en cualquier sentido.
  if (sortBy === 'categoria' && (left === '') !== (right === '')) return left === '' ? 1 : -1;
  const order = typeof left === 'number' && typeof right === 'number' ? left - right : String(left).localeCompare(String(right), locale);
  return sortDir === 'asc' ? order : -order;
});
const sortHref = (column: SortColumn) => {
  const next = new URLSearchParams(params);
  const toggled = sortBy === column ? (sortDir === 'asc' ? 'desc' : 'asc') : column === 'fecha' ? 'desc' : 'asc';
  next.set('orden', column);
  next.set('dir', toggled);
  return `?${next.toString()}`;
};
const ariaSort = (column: SortColumn) => (sortBy === column ? (sortDir === 'asc' ? 'ascending' : 'descending') : 'none');
const canWrite = workspace.role !== 'viewer';
const messages = messagesFor(locale, ['movements.', 'common.', 'import.plan.', 'validation.']);
const addableCards = accounts.filter((account) => !account.archivedAt).flatMap((account) => account.cards.filter((card) => !card.archivedAt).map((card) => ({ id: card.id, label: `${account.name} ···· ${card.last4 ?? '—'}${card.label ? ` · ${card.label}` : ''}` })));
const config = { canWrite, locale, categories: categories.map((c) => ({ id: c.id, name: c.name })) };
---

<AppLayout title={t(locale, 'movements.title')} active="spending">
  <h1>{t(locale, 'spending.title')}</h1>
  {scopedAccount && <Breadcrumb items={[{ label: t(locale, 'accounts.title'), href: '/app/cuentas' }, { label: scopedAccount.name, href: `/app/cuentas/${scopedAccount.id}` }, { label: t(locale, 'movements.title') }]} />}
  <SpendingTabs active="movements" month={isMonth(period) ? period : undefined} accountId={scopedAccount?.id} />
  {batch && <FilterChip name={t(locale, 'movements.batch.name', { name: batch.fileName })} clearHref="/app/gastos/movimientos" />}
  {scopeLabel && <FilterChip name={scopeLabel} nameHref={`/app/cuentas/${scopedAccount!.id}`} clearHref="/app/gastos/movimientos" />}

  {canWrite && (
    <details class="card-add movement-add" id="movement-add">
      <summary>{t(locale, 'movements.add.toggle')}</summary>
      {addableCards.length === 0 ? (
        <p class="hint">{t(locale, 'movements.add.noCards')}</p>
      ) : (
        <form id="movement-form" class="form-grid" novalidate>
          <div class="field">
            <label for="m-card">{t(locale, 'movements.add.card')}</label>
            <select id="m-card" name="cardId" required>
              <option value="">{t(locale, 'movements.add.cardChoose')}</option>
              {addableCards.map((card) => <option value={card.id} selected={card.id === cardFilter}>{card.label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="m-kind">{t(locale, 'movements.add.kind')}</label>
            <select id="m-kind" name="kind">
              <option value="charge">{t(locale, 'movements.add.kindCharge')}</option>
              <option value="credit">{t(locale, 'movements.add.kindCredit')}</option>
            </select>
          </div>
          <div class="field">
            <label for="m-date">{t(locale, 'movements.add.date')}</label>
            <input id="m-date" name="date" type="date" value={today} required />
          </div>
          <div class="field">
            <label for="m-description">{t(locale, 'movements.add.description')}</label>
            <input id="m-description" name="description" maxlength="120" required />
          </div>
          <div class="field">
            <label for="m-amount">{t(locale, 'movements.add.amount')}</label>
            <input id="m-amount" name="amount" inputmode="decimal" required />
          </div>
          <div class="field" id="m-category-field">
            <label for="m-category">{t(locale, 'movements.add.category')}</label>
            <select id="m-category" name="categoryId">
              <option value="">{t(locale, 'movements.add.categoryNone')}</option>
              {categories.map((category) => <option value={category.id}>{category.name}</option>)}
              <option value="__new__">{t(locale, 'movements.add.categoryNew')}</option>
            </select>
          </div>
          <div class="field" id="m-new-category-field" hidden>
            <label for="m-new-category">{t(locale, 'movements.add.newCategory')}</label>
            <input id="m-new-category" name="newCategory" maxlength="40" />
          </div>
          <div id="movement-form-error" class="alert" role="alert" hidden></div>
          <div class="form-actions"><button class="btn btn-auto" type="submit">{t(locale, 'movements.add.submit')}</button></div>
        </form>
      )}
    </details>
  )}

  <form class="card filters form-grid" method="get" action="/app/gastos/movimientos">
    {batch && <input type="hidden" name="lote" value={batch.id} />}
    <div class="field">
      <label for="f-period">{t(locale, 'movements.filter.period')}</label>
      <select id="f-period" name="mes">
        {cuts.length > 0 && (
          <optgroup label={t(locale, 'movements.period.statement')}>
            <option value="corte:actual" selected={period === 'actual'}>{t(locale, 'movements.period.sinceLast')} ({t(locale, 'movements.period.from', { from: formatDate(since!.from, locale) })})</option>
            {[...cuts].reverse().map((cut) => (
              <option value={`corte:${cut.month}`} selected={period === 'cut' && cut.month === selectedCut?.month}>
                {t(locale, 'movements.period.cutoffOption', { month: formatMonthLong(cut.month, locale), from: formatDate(cut.from, locale), to: formatDate(cut.to, locale) })}
              </option>
            ))}
          </optgroup>
        )}
        <optgroup label={t(locale, 'movements.period.byMonth')}>
          {months.map((entry) => <option value={entry} selected={entry === period}>{formatMonth(entry, locale)}</option>)}
        </optgroup>
        <option value="todo" selected={period === 'todo'}>{t(locale, 'movements.range.all')}</option>
      </select>
      {!scopedAccount && <span class="hint">{t(locale, 'movements.period.pickScope')}</span>}
      {scopedAccount && cuts.length === 0 && <span class="hint">{t(locale, 'movements.period.noCuts')} <a href="/app/importar/historial">{t(locale, 'import.history')}</a></span>}
    </div>
    <div class="field">
      <label for="f-scope">{t(locale, 'movements.filter.scope')}</label>
      <select id="f-scope" name="filtro">
        <option value="">{t(locale, 'movements.filter.allAccounts')}</option>
        {accounts.map((account) => (
          <optgroup label={account.name}>
            <option value={`a:${account.id}`} selected={account.id === accountFilter}>{t(locale, 'movements.filter.wholeAccount')}</option>
            {account.cards.map((card) => (
              <option value={`c:${card.id}`} selected={card.id === cardFilter}>···· {card.last4 ?? '—'}{card.label ? ` · ${card.label}` : ''}</option>
            ))}
          </optgroup>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="f-category">{t(locale, 'movements.filter.category')}</label>
      <select id="f-category" name="categoria">
        <option value="">{t(locale, 'movements.filter.allCategories')}</option>
        <option value="none" selected={categoryFilter === 'none'}>{t(locale, 'movements.filter.uncategorized')}</option>
        {categories.map((category) => <option value={category.id} selected={category.id === categoryFilter}>{category.name}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="f-type">{t(locale, 'movements.filter.type')}</label>
      <select id="f-type" name="tipo">
        {([['todos', 'typeAll'], ['hormiga', 'typeAnt'], ['gastos', 'typeSpend'], ['planes', 'typePlans'], ['intereses', 'typeFinance'], ['abonos', 'typeCredits']] as const).map(([value, label]) => (
          <option value={value} selected={value === type}>{t(locale, `movements.filter.${label}`)}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="f-q">{t(locale, 'movements.filter.search')}</label>
      <input id="f-q" name="q" type="search" value={q} maxlength="60" />
    </div>
    <div class="form-actions"><button class="btn btn-auto" type="submit">{t(locale, 'movements.filter.apply')}</button></div>
  </form>

  <p class="muted period-note">{periodNote}</p>

  <section class="card" id="movements" data-config={JSON.stringify(config)} data-messages={JSON.stringify(messages)}>
    <div id="movements-error" class="alert" role="alert" hidden></div>
    {
      rows.length === 0 ? (
        <p class="empty">{t(locale, 'movements.empty')}</p>
      ) : (
        <>
          <p class="hint">{t(locale, 'movements.count', { n: rows.length })}{list.length >= 1000 ? ` · ${t(locale, 'movements.truncated')}` : ''}</p>

          {canWrite && (
            <div id="bulk-bar" class="bulk-bar" hidden>
              <span id="bulk-label"></span>
              <select id="bulk-category" aria-label={t(locale, 'movements.bulk.choose')}>
                <option value="">{t(locale, 'movements.bulk.choose')}</option>
                <option value="none">{t(locale, 'movements.bulk.none')}</option>
                {categories.map((category) => <option value={category.id}>{category.name}</option>)}
              </select>
              <button type="button" class="btn btn-small" id="bulk-apply">{t(locale, 'movements.bulk.apply')}</button>
              {cutChoices.length > 0 && (
                <>
                  <select id="bulk-cut" aria-label={t(locale, 'movements.bulk.cut')}>
                    <option value="">{t(locale, 'movements.bulk.cut')}</option>
                    <option value="date">{t(locale, 'movements.cut.byDate')}</option>
                    {cutChoices.map((choice) => <option value={choice.month}>{t(locale, 'movements.cut.option', { month: choice.label })}</option>)}
                  </select>
                  <button type="button" class="btn btn-small" id="bulk-cut-apply">{t(locale, 'movements.bulk.cutApply')}</button>
                </>
              )}
            </div>
          )}

          <div class="table-scroll">
            <table class:list={['import-table', 'movements-table', canWrite && 'has-pick']}>
<caption class="sr-only">{t(locale, 'table.sr.movements')}</caption>
              <thead>
                <tr>
                  {canWrite && <th scope="col" class="col-pick"><label class="pick-label"><input type="checkbox" id="select-all" aria-label={t(locale, 'movements.selectAll')} /></label></th>}
                  {([['fecha', 'date', 'col-date'], ['descripcion', 'description', ''], ['monto', 'amount', 'num'], ['tarjeta', 'card', ''], ['categoria', 'category', '']] as const).map(([column, label, cls]) => (
                    <th scope="col" class={cls} aria-sort={ariaSort(column)}>
                      <a class="sort-link" href={sortHref(column)} aria-label={t(locale, 'movements.sort.by', { column: t(locale, `movements.col.${label}`) })}>
                        <span>{t(locale, `movements.col.${label}`)}</span>
                        <svg class="sort-icon" viewBox="0 0 10 14" width="10" height="14" aria-hidden="true" focusable="false">
                          <path d="M5 1 8.5 5.5h-7z" fill="currentColor" opacity={sortBy === column && sortDir === 'asc' ? 1 : 0.28}></path>
                          <path d="M5 13 1.5 8.5h7z" fill="currentColor" opacity={sortBy === column && sortDir === 'desc' ? 1 : 0.28}></path>
                        </svg>
                      </a>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {sortedRows.map((row) => {
                  const charge = row.chargeMinor > 0;
                  const ant = isAnt(row, thresholdOf(row.currency));
                  const group = groups.get(row.id);
                  return (
                    <tr data-id={row.id} data-desc={row.descriptionNorm} data-name={row.description} data-amount={charge ? toInputString(group?.totalMinor ?? row.chargeMinor, locale, row.currency) : undefined} data-type={group ? 'mci' : undefined}>
                      {canWrite && <td class="col-pick">{charge && <label class="pick-label"><input type="checkbox" class="pick" aria-label={row.description} /></label>}</td>}
                      <td class="nowrap col-date">{formatDate(row.date, locale)}</td>
                      <td>
                        {row.description}
                        {row.reference && <><br /><span class="muted">{row.reference}</span></>}
                        {(row.planId || group || isFinance(row) || (ant && !group) || row.statementMonth) && (
                          <div class="cell-tags">
                            {row.statementMonth && <span class="badge badge-warn">{t(locale, 'movements.cut.manualBadge', { month: formatMonthLong(row.statementMonth, locale) })}</span>}
                            {row.planId && <a class="badge" href={`/app/planes/${row.planId}`}>{t(locale, 'movements.plan')}</a>}
                            {group && <span class="badge badge-muted">{t(locale, 'movements.group.badge')}</span>}
                            {isFinance(row) && <span class="badge badge-muted">{t(locale, 'movements.finance')}</span>}
                            {ant && !group && <span class="badge badge-muted">{t(locale, 'movements.ant')}</span>}
                          </div>
                        )}
                        {group && (
                          <details class="payment-group">
                            <summary>{t(locale, 'movements.group.summary', { n: group.chargeKeys.length })}</summary>
                            <ul class="group-lines">
                              {[row.id, ...group.chargeKeys.filter((id) => id !== row.id)].map((id) => (
                                <li><span>{id === row.id ? t(locale, 'movements.group.required') : rowById.get(id)!.description}</span><span class="num">{formatMinor(rowById.get(id)!.chargeMinor, row.currency, locale)}</span></li>
                              ))}
                              {group.creditKeys.map((id) => (
                                <li class="muted"><span>{t(locale, 'movements.group.converted')}</span><span class="num">−{formatMinor(rowById.get(id)!.creditMinor, row.currency, locale)}</span></li>
                              ))}
                            </ul>
                          </details>
                        )}
                        {canWrite && cutChoices.length > 0 && row.accountId === scopedAccount?.id && (
                          <div class="cell-tags">
                            <select class="row-cut" data-current={row.statementMonth ?? ''} aria-label={t(locale, 'movements.cut.label')}>
                              <option value="">{t(locale, 'movements.cut.byDate')}</option>
                              {cutChoices.map((choice) => <option value={choice.month} selected={choice.month === row.statementMonth}>{t(locale, 'movements.cut.option', { month: choice.label })}</option>)}
                            </select>
                          </div>
                        )}
                        {canWrite && charge && !row.planId && <div class="cell-tags"><button type="button" class="link-button convert-plan">{t(locale, 'movements.plan.convert')}</button></div>}
                      </td>
                      <td class="num nowrap">{charge ? formatMinor(group?.totalMinor ?? row.chargeMinor, row.currency, locale) : <span class="credit">+{formatMinor(row.creditMinor, row.currency, locale)}</span>}</td>
                      <td class="nowrap">{row.accountName}{row.last4 ? ` ···· ${row.last4}` : ''}</td>
                      <td>
                        {charge && (canWrite ? (
                          <>
                            <select class="row-category" data-current={row.categoryId ?? ''} aria-label={t(locale, 'movements.col.category')}>
                              <option value="">—</option>
                              {categories.map((category) => <option value={category.id} selected={category.id === row.categoryId}>{category.name}</option>)}
                            </select>
                            <span class="suggest"></span>
                          </>
                        ) : (
                          row.categoryId ? (byId.get(row.categoryId)?.name ?? '') : '—'
                        ))}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {canWrite && categories.length === 0 && <p class="hint">{t(locale, 'movements.noCategories')} <a href="/app/gastos/categorias">{t(locale, 'spending.tab.categories')}</a></p>}
        </>
      )
    }
  </section>
</AppLayout>

<script>
  import '../../../scripts/spending-movements';
  import '../../../scripts/movement-form';
</script>
