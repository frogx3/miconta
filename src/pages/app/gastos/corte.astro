---
import AppLayout from '../../../layouts/AppLayout.astro';
import SpendingTabs from '../../../components/SpendingTabs.astro';
import { listAccounts } from '../../../lib/accounts/repo';
import { messagesFor, t } from '../../../i18n/messages';
import { getDb } from '../../../lib/auth';
import { lastCutoffDate } from '../../../lib/cutoff';
import { formatDate, formatMonthLong, todayISO } from '../../../lib/date-format';
import { formatMinor, toInputString } from '../../../lib/money-format';
import { listPlans } from '../../../lib/plans/repo';
import { shiftMonth, thresholdFor } from '../../../lib/spending/analysis';
import { getWorkspaceSettings, listCutoffs, movementsForAccount } from '../../../lib/spending/repo';
import { cutoffInMonth, realCuts, sinceLastCut, summarizeStatement } from '../../../lib/spending/statement';

const { workspace, locale } = Astro.locals;
if (!workspace) return Astro.redirect('/login');

const db = getDb();
const today = todayISO();
const params = Astro.url.searchParams;
// El estado de cuenta es por cuenta (la tarjeta física y la digital comparten corte). Hace falta una tarjeta de crédito para el día de pago y la moneda.
const accounts = (await listAccounts(db, workspace.id))
  .map((entry) => ({ entry, credit: entry.cards.filter((card) => card.kind === 'credit' && card.cutoffDay !== null && !card.archivedAt) }))
  .filter((item) => item.credit.length > 0);
const selected = accounts.find((item) => item.entry.id === params.get('cuenta')) ?? accounts[0];
const account = selected?.entry;
// El día de pago y la moneda vienen de la primera tarjeta de crédito (la titular).
const primary = selected?.credit[0];
const canWrite = workspace.role !== 'viewer';

/**
 * Los cortes son los reales: los que se capturaron al cargar un CSV, en el historial de cargas o aquí. No se estiman con el
 * día de corte de la tarjeta porque los bancos lo mueven. Además de cada corte hay un periodo "en curso": lo que va desde el
 * último corte real, sin fecha de cierre conocida.
 */
type StatementView = {
  key: string;
  kind: 'cut' | 'open' | 'none';
  from: string | null;
  to: string | null;
  cutoff: string | null;
  dueDate: string | null;
  recorded: { startDate: string | null; officialPayMinor: number | null } | null;
  recordId: string;
  /** Fecha de corte sugerida para el formulario de captura. */
  suggestedCutoff: string;
  summary: ReturnType<typeof summarizeStatement> | null;
  thresholdMinor: number;
  planNames: Map<string, string>;
  prev: string | null;
  next: string | null;
};
let view: StatementView | null = null;

if (account && primary) {
  const records = await listCutoffs(db, workspace.id, account.id);
  const cuts = realCuts(records, primary.cutoffDay, primary.paymentDueDay);
  const since = sinceLastCut(cuts);
  const items = [...cuts.map((cut) => cut.month), ...(since ? ['actual'] : [])];
  const requested = params.get('corte');
  const key = items.includes(requested ?? '') ? requested! : (cuts.at(-1)?.month ?? '');
  const index = items.indexOf(key);
  const cut = cuts.find((entry) => entry.month === key);
  const kind = cut ? 'cut' : since && key === 'actual' ? 'open' : 'none';
  const from = cut?.from ?? (kind === 'open' ? since!.from : null);
  const to = cut?.to ?? (kind === 'open' ? '9999-12-31' : null);
  const [rows, settings, plans] = await Promise.all([
    from && to ? movementsForAccount(db, workspace.id, account.id, primary.currency, from, to) : Promise.resolve([]),
    getWorkspaceSettings(db, workspace.id),
    listPlans(db, workspace.id),
  ]);
  const thresholdMinor = thresholdFor(primary.currency, { currency: settings.currency, thresholdMinor: settings.thresholdMinor });
  const lastCut = cuts.at(-1);
  view = {
    key,
    kind,
    from,
    to: cut?.to ?? null,
    cutoff: cut?.cutoff ?? null,
    dueDate: cut?.dueDate ?? null,
    recorded: cut?.recorded ?? null,
    recordId: records.find((record) => record.cutoffDate === cut?.cutoff)?.id ?? '',
    // Sin cortes, el último día de corte según la tarjeta; con ellos, el mes siguiente al último corte real.
    suggestedCutoff: cut?.cutoff ?? (lastCut ? cutoffInMonth(primary.cutoffDay!, shiftMonth(lastCut.month, 1)) : lastCutoffDate(primary.cutoffDay!, today)),
    summary: from && to ? summarizeStatement(rows, thresholdMinor, cut && index > 0 ? (cuts[index - 1]?.recorded.officialPayMinor ?? null) : null) : null,
    thresholdMinor,
    planNames: new Map(plans.map((plan) => [plan.id, plan.name])),
    prev: index > 0 ? items[index - 1]! : null,
    next: index >= 0 && index < items.length - 1 ? items[index + 1]! : null,
  };
}

const currency = primary?.currency ?? workspace.defaultCurrency;
const accountQuery = account ? `cuenta=${account.id}&` : '';
const money = (minor: number) => formatMinor(minor, currency, locale);
const official = view?.recorded?.officialPayMinor ?? null;
const messages = messagesFor(locale, ['statement.', 'validation.', 'common.']);
const periodLabel = view?.kind === 'cut' ? t(locale, 'statement.period', { from: formatDate(view.from!, locale), to: formatDate(view.to!, locale) }) : view?.kind === 'open' ? `${t(locale, 'movements.period.sinceLast')} · ${t(locale, 'movements.period.from', { from: formatDate(view.from!, locale) })}` : '';
const cutTitle = view?.kind === 'cut' ? t(locale, 'movements.period.cutoffName', { month: formatMonthLong(view.key, locale) }) : '';
---

<AppLayout title={t(locale, 'statement.title')} active="spending">
  <h1>{t(locale, 'spending.title')}</h1>
  <SpendingTabs active="statement" />

  {
    !account || !primary || !view ? (
      <section class="card">
        <p class="empty">{t(locale, 'statement.noCards')}</p>
        <a class="btn btn-link" href="/app/cuentas">{t(locale, 'statement.noCardsLink')}</a>
      </section>
    ) : (
      <>
        <p class="hint">{t(locale, 'statement.hint')}</p>

        {accounts.length > 1 && (
          <form class="card filters form-grid" method="get" action="/app/gastos/corte">
            <div class="field">
              <label for="s-account">{t(locale, 'statement.account')}</label>
              <select id="s-account" name="cuenta" onchange="this.form.submit()">
                {accounts.map((item) => <option value={item.entry.id} selected={item.entry.id === account.id}>{item.entry.name}</option>)}
              </select>
            </div>
            <noscript><div class="form-actions"><button class="btn btn-auto" type="submit">{t(locale, 'movements.filter.apply')}</button></div></noscript>
          </form>
        )}

        {
          view.kind !== 'none' ? (
            <>
              <div class="month-nav">
                {view.prev ? <a href={`/app/gastos/corte?${accountQuery}corte=${view.prev}`} aria-label={t(locale, 'statement.prev')}>←</a> : <span class="muted">←</span>}
                <strong>{cutTitle && `${cutTitle} · `}{periodLabel}</strong>
                {view.next ? <a href={`/app/gastos/corte?${accountQuery}corte=${view.next}`} aria-label={t(locale, 'statement.next')}>→</a> : <span class="muted">→</span>}
                {view.kind === 'open' && <span class="badge">{t(locale, 'statement.open')}</span>}
              </div>
              <p class="muted">{t(locale, 'statement.scope', { account: account.name, count: String(selected!.entry.cards.filter((card) => !card.archivedAt).length) })}</p>
              {view.kind === 'open' && <p class="hint">{t(locale, 'statement.openNote')}</p>}
            </>
          ) : (
            <section class="card"><p class="empty">{t(locale, 'statement.noCuts')}</p></section>
          )
        }

        {
          view.summary === null ? null : view.summary.chargeCount === 0 && view.summary.creditsMinor === 0 ? (
            <section class="card"><p class="empty">{t(locale, 'statement.empty')}</p></section>
          ) : (
            <section class="card">
              <div class="stats">
                <div class="stat stat-pay">
                  <span class="muted">{t(locale, 'statement.pay')}</span>
                  <strong>{money(view.summary.payMinor)}</strong>
                  <span class="hint">{t(locale, view.summary.payBasis === 'exact' ? 'statement.payHintExact' : 'statement.payHint', { n: String(view.summary.chargeCount) })}</span>
                  {view.summary.refundsMinor > 0 && (
                    <span class="hint">{t(locale, 'statement.payRefunds', { charges: money(view.summary.chargesMinor), refunds: money(view.summary.refundsMinor) })}</span>
                  )}
                  {view.dueDate && <span class="hint"><strong>{t(locale, 'statement.due', { date: formatDate(view.dueDate, locale) })}</strong></span>}
                </div>
                {official !== null && (
                  <div class="stat">
                    <span class="muted">{t(locale, 'statement.official')}</span>
                    <strong>{money(official)}</strong>
                    <span class="hint">
                      {view.summary.payMinor === official
                        ? t(locale, 'statement.matches')
                        : t(locale, 'statement.difference', { amount: `${view.summary.payMinor > official ? '+' : '−'}${money(Math.abs(view.summary.payMinor - official))}` })}
                    </span>
                  </div>
                )}
                <div class="stat">
                  <span class="muted">{t(locale, 'statement.plans')}</span>
                  <strong>{money(view.summary.planChargesMinor)}</strong>
                  <span class="hint">{t(locale, 'statement.plansHint')}</span>
                </div>
                <div class="stat">
                  <span class="muted">{t(locale, 'statement.spend')}</span>
                  <strong>{money(view.summary.spendMinor)}</strong>
                  <span class="hint">{t(locale, 'movements.count', { n: String(view.summary.spendCount) })}</span>
                </div>
                {view.summary.financeMinor > 0 && (
                  <div class="stat">
                    <span class="muted">{t(locale, 'statement.finance')}</span>
                    <strong>{money(view.summary.financeMinor)}</strong>
                    <span class="hint">{t(locale, 'statement.financeHint')}</span>
                  </div>
                )}
                <div class="stat stat-ant">
                  <span class="muted">{t(locale, 'statement.ant')}</span>
                  <strong>{money(view.summary.antMinor)}</strong>
                  <span class="hint">{t(locale, 'statement.antHint', { n: String(view.summary.antCount), threshold: money(view.thresholdMinor) })}</span>
                </div>
                <div class="stat">
                  <span class="muted">{t(locale, 'statement.credits')}</span>
                  <strong>{money(view.summary.creditsMinor)}</strong>
                  <span class="hint">{t(locale, 'statement.creditsHint')}</span>
                </div>
              </div>

              <h2>{t(locale, 'statement.byPlan')}</h2>
              {
                view.summary.byPlan.length === 0 ? (
                  <p class="empty">{t(locale, 'statement.noPlans')}</p>
                ) : (
                  <div class="table-scroll">
                    <table class="import-table">
                      <caption class="sr-only">{t(locale, 'statement.byPlan')}</caption>
                      <tbody>
                        {view.summary.byPlan.map((entry) => (
                          <tr>
                            <td><a href={`/app/planes/${entry.planId}`}>{view.planNames.get(entry.planId) ?? '—'}</a></td>
                            <td class="num muted nowrap">{t(locale, 'statement.byPlanCount', { n: String(entry.count) })}</td>
                            <td class="num nowrap"><strong>{money(entry.amountMinor)}</strong></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              }

              <p class="row-actions">
                <a class="touch-link" href={`/app/gastos/movimientos?mes=corte:${view.key}&filtro=a:${account.id}`}>{t(locale, 'statement.viewMovements')} →</a>
              </p>
            </section>
          )
        }

        {canWrite && (
          <section class="card" id="cutoff" data-messages={JSON.stringify(messages)} data-account-id={account.id} data-record-id={view.recordId}>
            <h2>{t(locale, view.kind === 'cut' ? 'statement.real.title' : 'statement.real.titleNew')}</h2>
            <p class="hint">{t(locale, 'statement.real.hint')}</p>
            <div id="cutoff-done" class="alert ok" role="status" hidden />
            <div id="cutoff-error" class="alert" role="alert" hidden />
            <form id="cutoff-form" class="form-grid" novalidate>
              <div class="field narrow">
                <label for="cutoffDate">{t(locale, 'statement.real.cutoff')}</label>
                <input id="cutoffDate" name="cutoffDate" type="date" required value={view.suggestedCutoff} />
                <span class="field-error" data-error-for="cutoffDate" />
              </div>
              <div class="field narrow">
                <label for="startDate">{t(locale, 'statement.real.start')}</label>
                <input id="startDate" name="startDate" type="date" value={view.recorded?.startDate ?? ''} />
                <span class="hint">{view.from ? t(locale, 'statement.real.startHint', { date: formatDate(view.from, locale) }) : t(locale, 'statement.real.startNone')}</span>
                <span class="field-error" data-error-for="startDate" />
              </div>
              <div class="field narrow">
                <label for="officialPay">{t(locale, 'statement.real.pay', { currency })}</label>
                <input id="officialPay" name="officialPay" type="text" inputmode="decimal" value={official !== null ? toInputString(official, locale, currency) : ''} />
                <span class="field-error" data-error-for="officialPay" />
              </div>
              <div class="form-actions">
                <button class="btn btn-auto" type="submit">{t(locale, 'statement.real.save')}</button>
                {view.kind === 'cut' && <button class="btn btn-ghost" type="button" id="cutoff-remove">{t(locale, 'statement.real.remove')}</button>}
              </div>
            </form>
          </section>
        )}
      </>
    )
  }
</AppLayout>

<script>
  import '../../../scripts/statement-cutoff';
</script>
