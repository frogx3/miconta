---
import AppLayout from '../../layouts/AppLayout.astro';
import Help from '../../components/Help.astro';
import Icon from '../../components/Icon.astro';
import { t, tn } from '../../i18n/messages';
import { getDb } from '../../lib/auth';
import { listAccounts } from '../../lib/accounts/repo';
import { formatDate, todayISO } from '../../lib/date-format';
import { formatMinor } from '../../lib/money-format';
import { listPlans, payDateResolver } from '../../lib/plans/repo';
import { summarize } from '../../lib/plans/schedule';
import GoalCard from '../../components/GoalCard.astro';
import { buildGoalViews } from '../../lib/goals/view';
import { currentAgenda, upcomingEntries } from '../../lib/agenda/month';
import { addDays } from '../../lib/spending/statement';
import UpcomingList from '../../components/UpcomingList.astro';

const { user, workspace, locale } = Astro.locals;
if (!user) return Astro.redirect('/login');

const accounts = workspace ? await listAccounts(getDb(), workspace.id) : [];
const summaries = workspace ? summarize(await listPlans(getDb(), workspace.id), todayISO(Astro.locals.timeZone), 36, await payDateResolver(getDb(), workspace.id)) : [];
const goalViews = workspace ? (await buildGoalViews(getDb(), workspace.id, todayISO(Astro.locals.timeZone))).slice(0, 4) : [];

// Agenda del mes: solo si hay algo cargado (pagos, cobros o saldos).
const today = todayISO(Astro.locals.timeZone);
const agenda = await currentAgenda(Astro.locals, getDb(), today);
const hasAgenda = Boolean(agenda && (agenda.entries.length > 0 || agenda.balances.length > 0));
const upcoming = upcomingEntries(agenda?.entries ?? []);
const money = (minor: number, currency: string) => formatMinor(minor, currency, locale);
---

<AppLayout title={t(locale, 'app.dashboard.title')} active="dashboard">
  <h1>{t(locale, 'app.dashboard.welcome', { name: user.name })}</h1>

  {
    hasAgenda && agenda && (
      <section class="card home-agenda">
        <h2>{t(locale, 'app.dashboard.agenda')}<Help topic="agenda.available" /></h2>
        {agenda.results.map((r) => (
          <div class:list={['agenda-result', r.resultMinor > 0 ? 'tone-good' : r.resultMinor < 0 ? 'tone-bad' : 'tone-zero']}>
            <p class="agenda-answer">
              {r.resultMinor > 0 ? t(locale, 'agenda.result.surplus', { amount: money(r.resultMinor, r.currency) }) : r.resultMinor < 0 ? t(locale, 'agenda.result.short', { amount: money(-r.resultMinor, r.currency) }) : t(locale, 'agenda.result.zero')}
            </p>
            <p class="muted">{t(locale, 'agenda.math', { available: money(r.availableMinor, r.currency), receivable: money(r.receivableMinor, r.currency), payable: money(r.payableMinor, r.currency) })}</p>
          </div>
        ))}
        {upcoming.length > 0 && (
          <>
            <h3>{t(locale, 'app.dashboard.agendaNext')}</h3>
            <UpcomingList entries={upcoming} today={today} tomorrow={addDays(today, 1)} />
          </>
        )}
        <a class="touch-link" href="/app/agenda">{t(locale, 'app.dashboard.agendaLink')} →</a>
      </section>
    )
  }

  {
    summaries.map((summary) => (
      <section class="card">
        <div class="stats">
          <div class="stat">
            <span class="muted">{t(locale, 'plans.summary.thisMonth')} · {summary.currency}</span>
            <strong>{formatMinor(summary.thisMonthMinor, summary.currency, locale)}</strong>
          </div>
          <div class="stat">
            <span class="muted">{t(locale, 'plans.summary.remaining')}</span>
            <strong>{formatMinor(summary.remainingBalanceMinor, summary.currency, locale)}</strong>
          </div>
          {summary.debtFreeDate && (
            <div class="stat">
              <span class="muted">{t(locale, 'plans.summary.debtFree')}</span>
              <strong class="milestone">{formatDate(summary.debtFreeDate, locale)}</strong>
            </div>
          )}
        </div>
        <a class="touch-link" href="/app/planes">{t(locale, 'app.dashboard.plans')} →</a>
      </section>
    ))
  }

  {
    goalViews.length > 0 && (
      <section class="card">
        <h2>{t(locale, 'goals.dashboard.title')}<Help topic="goals.dashboard.title" /></h2>
        <div class="goal-list">{goalViews.map((view) => <GoalCard view={view} compact />)}</div>
        <a class="touch-link" href="/app/metas">{t(locale, 'goals.dashboard.all')} →</a>
      </section>
    )
  }

  <section class="card">
    {
      accounts.length === 0 ? (
        <>
          <p class="empty">{t(locale, 'accounts.empty')}</p>
          {workspace?.role !== 'viewer' && (
            <a class="btn btn-link" href="/app/cuentas/nueva">
              {t(locale, 'accounts.new')}
            </a>
          )}
        </>
      ) : (
        <>
          <h2>{t(locale, 'app.dashboard.accountsList')}<Help topic="app.dashboard.accountsList" /></h2>
          <ul class="account-links">
            {accounts.map((account) => (
              <li>
                <a href={`/app/cuentas/${account.id}`}>
                  <span class="activity-icon"><Icon name="landmark" size={20} /></span>
                  <span>
                    <strong>{account.name}</strong>
                    <span class="muted activity-sub">{account.bank} · {tn(locale, 'app.dashboard.cardsCount', account.cards.filter((card) => !card.archivedAt).length)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="row-actions">
            <a class="touch-link" href="/app/cuentas">{t(locale, 'nav.accounts')} →</a>
            {workspace?.role !== 'viewer' && summaries.length === 0 && (
              <a class="btn btn-link" href="/app/importar">
                <Icon name="upload" size={18} /> {t(locale, 'app.dashboard.import')}
              </a>
            )}
          </div>
        </>
      )
    }
  </section>

</AppLayout>
