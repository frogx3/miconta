---
import AppLayout from '../../../layouts/AppLayout.astro';
import Help from '../../../components/Help.astro';
import FilterChip from '../../../components/FilterChip.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { messagesFor, t, tn } from '../../../i18n/messages';
import { getDb } from '../../../lib/auth';
import { formatDate, formatMonth, todayISO } from '../../../lib/date-format';
import { remainingBalanceMinor } from '../../../lib/import/plans';
import { formatMinor } from '../../../lib/money-format';
import { getAccount } from '../../../lib/accounts/repo';
import { listPlans, payDateResolver } from '../../../lib/plans/repo';
import { isOpen, lastPayDate, stillPaying, summarize, summarizeByCard } from '../../../lib/plans/schedule';
import { listTags, plansWithTag, tagsByPlan } from '../../../lib/plans/tags';
import Segments from '../../../components/Segments.astro';
import { releases } from '../../../lib/plans/releases';
import { cardTones } from '../../../lib/accounts/format';
import { listAccounts } from '../../../lib/accounts/repo';

const { workspace, locale } = Astro.locals;
if (!workspace) return Astro.redirect('/login');

const [everything, payDateOf] = await Promise.all([listPlans(getDb(), workspace.id), payDateResolver(getDb(), workspace.id)]);
const today = todayISO(Astro.locals.timeZone);
const accountFilter = Astro.url.searchParams.get('cuenta') ?? '';
const all = accountFilter ? everything.filter((plan) => plan.accountId === accountFilter) : everything;
const summaries = summarize(all, today, 36, payDateOf);
const byCurrencyCards = summarizeByCard(all, today, payDateOf);
const scopeName = accountFilter ? ((await getAccount(getDb(), workspace.id, accountFilter))?.name ?? '') : '';

const tab = Astro.url.searchParams.get('estado') === 'cerrados' ? 'closed' : 'active';
const cardFilter = Astro.url.searchParams.get('tarjeta') ?? '';
const [tagMap, allTags] = await Promise.all([tagsByPlan(getDb(), workspace.id), listTags(getDb(), workspace.id)]);
const tagFilter = allTags.some((tag) => tag.id === Astro.url.searchParams.get('etiqueta')) ? Astro.url.searchParams.get('etiqueta')! : '';
const withTag = tagFilter ? plansWithTag(tagMap, tagFilter) : null;
const cards = [...new Map(all.map((plan) => [plan.cardId, plan.cardName])).entries()];

// Un plan liquidado sigue en activos hasta que vence el pago de su última mensualidad.
const inTab = all.filter((plan) => (tab === 'active') === stillPaying(plan, today, payDateOf));
const endOf = new Map(all.map((plan) => [plan.id, lastPayDate(plan, payDateOf)]));
const shown = inTab
  .filter((plan) => !cardFilter || plan.cardId === cardFilter)
  .filter((plan) => !withTag || withTag.has(plan.id))
  .sort((a, b) => endOf.get(a.id)!.localeCompare(endOf.get(b.id)!) || a.name.localeCompare(b.name));

const href = (params: Record<string, string>) => {
  const merged = {
    ...params,
    ...(accountFilter && !('cuenta' in params) ? { cuenta: accountFilter } : {}),
    ...(tagFilter && !('etiqueta' in params) ? { etiqueta: tagFilter } : {}),
  };
  const query = new URLSearchParams(Object.entries(merged).filter(([, value]) => value)).toString();
  return `/app/planes${query ? `?${query}` : ''}`;
};
const VISIBLE_MONTHS = 12;
const canWrite = workspace.role !== 'viewer';
const balanceAccounts = [...new Map(everything.map((plan) => [plan.accountId, plan.accountName])).entries()];
const balanceMessages = messagesFor(locale, ['balances.', 'validation.', 'common.']);
const tones = cardTones(await listAccounts(getDb(), workspace.id, true));
// Lista agrupada por tarjeta, en el orden de término del primer plan de cada una.
const groups = [...new Map(shown.map((plan) => [plan.cardId, { cardId: plan.cardId, cardName: plan.cardName, plans: shown.filter((other) => other.cardId === plan.cardId) }])).values()];
const cardSummaryOf = (cardId: string) => byCurrencyCards.flatMap((entry) => entry.cards).find((card) => card.cardId === cardId);
const monthLong = (key: string) => new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${key}-01T00:00:00Z`));
---

<AppLayout title={t(locale, 'plans.title')} active="plans">
  {accountFilter && scopeName && <Breadcrumb items={[{ label: t(locale, 'accounts.title'), href: '/app/cuentas' }, { label: scopeName, href: `/app/cuentas/${accountFilter}` }, { label: t(locale, 'plans.title') }]} />}
  <h1>{t(locale, 'plans.title')}<Help topic="plans.title" /></h1>
  {accountFilter && scopeName && <FilterChip name={scopeName} nameHref={`/app/cuentas/${accountFilter}`} clearHref="/app/planes" />}

  {
    all.length === 0 ? (
      <section class="card">
        <p class="empty">{t(locale, 'plans.empty')}</p>
        {workspace.role !== 'viewer' && (
          <a class="btn btn-link" href="/app/importar">
            {t(locale, 'nav.import')}
          </a>
        )}
      </section>
    ) : (
      <>
        {summaries.map((summary) => {
          const max = Math.max(...summary.months.map((m) => m.amountMinor), 1);
          const money = (minor: number) => formatMinor(minor, summary.currency, locale);
          const row = (month: (typeof summary.months)[number], index: number) => {
            const delta = index === 0 ? 0 : month.amountMinor - summary.months[index - 1]!.amountMinor;
            return (
              <tr>
                <td class="nowrap">{formatMonth(month.month, locale)}</td>
                <td class="bar-cell">
                  <span class="bar" aria-hidden="true">
                    <span style={`width:${(month.amountMinor / max) * 100}%`} />
                    {delta < 0 && <span class="bar-shed" style={`width:${(-delta / max) * 100}%`} />}
                  </span>
                </td>
                <td class="num nowrap">
                  {money(month.amountMinor)}
                  {month.overdue > 0 && <span class="hint block">{t(locale, 'plans.projection.overdue', { n: month.overdue })}</span>}
                </td>
                <td class="num">{month.plans}</td>
                <td class="num nowrap">{delta < 0 ? <span class="freed">−{money(-delta)}</span> : delta > 0 ? `+${money(delta)}` : ''}</td>
              </tr>
            );
          };
          return (
            <section class="card plans-free" aria-labelledby={`free-${summary.currency}`}>
              <div>
                <h2 id={`free-${summary.currency}`}>{t(locale, 'plans.free.title')}{summaries.length > 1 && ` · ${summary.currency}`}</h2>
                <p class="hint">{t(locale, 'plans.free.hint')}</p>
                {(() => {
                  // Respeta los filtros de tarjeta y etiqueta; en «Cerrados» no aplica (son planes que ya no se pagan).
                  const list = tab === 'active' ? releases(all.filter((plan) => (!cardFilter || plan.cardId === cardFilter) && (!withTag || withTag.has(plan.id))), summary.currency, today, payDateOf).slice(0, 8) : [];
                  return list.length === 0 ? (
                    tab === 'active' && <p class="empty">{t(locale, 'plans.free.none')}</p>
                  ) : (
                    <ol class="freelist">
                      {list.map((entry) => (
                        <li>
                          <span class="freelist-month">{monthLong(entry.month)}</span>
                          <span class="freelist-dot" aria-hidden="true"></span>
                          <span class="freelist-what">
                            {entry.plans.map((item, index) => (
                              <>
                                {index > 0 && ', '}
                                <a href={`/app/planes/${item.id}`}>{item.name}</a>
                              </>
                            ))}
                          </span>
                          <span class="freelist-amount">{t(locale, 'plans.free.amount', { amount: money(entry.freedMinor) })}</span>
                        </li>
                      ))}
                    </ol>
                  );
                })()}
              </div>
              <div class="free-side">
                <div class="kv"><span>{t(locale, 'plans.summary.thisMonth')}<Help topic="plans.summary.thisMonth" /></span><strong>{money(summary.thisMonthMinor)}</strong></div>
                <div class="kv"><span>{t(locale, 'plans.summary.remaining')}<Help topic="plans.summary.remaining" /></span><strong>{money(summary.remainingBalanceMinor)}</strong></div>
                <div class="kv"><span>{t(locale, 'plans.summary.active')}<Help topic="plans.summary.active" /></span><strong>{summary.openPlans}</strong></div>
                {summary.debtFreeDate && <div class="kv"><span>{t(locale, 'plans.summary.debtFree')}<Help topic="plans.summary.debtFree" /></span><strong class="milestone">{monthLong(summary.debtFreeDate.slice(0, 7))}</strong></div>}
                {summary.overdueInstallments > 0 && <p class="notice" role="note">{t(locale, 'plans.free.overdue', { n: summary.overdueInstallments })}</p>}
              </div>
              <details class="free-ladder">
              <summary>
                {t(locale, 'plans.projection.title')} · {summary.currency}
              </summary>
              <p class="hint">{t(locale, 'plans.projection.hint')}</p>
              <div class="table-scroll">
                <table class="import-table ladder">
<caption class="sr-only">{t(locale, 'table.sr.ladder')}</caption>
                  <thead>
                    <tr>
                      <th scope="col">{t(locale, 'plans.projection.month')}<Help topic="plans.projection.month" /></th>
                      <th scope="col" />
                      <th scope="col" class="num">{t(locale, 'plans.projection.amount')}<Help topic="plans.projection.amount" /></th>
                      <th scope="col" class="num">{t(locale, 'plans.projection.plans')}<Help topic="plans.projection.plans" /></th>
                      <th scope="col" class="num">{t(locale, 'plans.projection.delta')}<Help topic="plans.projection.delta" /></th>
                    </tr>
                  </thead>
                  <tbody>{summary.months.slice(0, VISIBLE_MONTHS).map((month, index) => row(month, index))}</tbody>
                  {summary.months.length > VISIBLE_MONTHS && (
                    <tbody class="more">{summary.months.slice(VISIBLE_MONTHS).map((month, index) => row(month, index + VISIBLE_MONTHS))}</tbody>
                  )}
                </table>
              </div>
              </details>
            </section>
          );
        })}

        <div class="page-head">
          <div class="chips">
            <a class:list={['chip chip-button', tab === 'active' && 'is-on']} href={href({ tarjeta: cardFilter })}>{t(locale, 'plans.tab.active')}</a>
            <a class:list={['chip chip-button', tab === 'closed' && 'is-on']} href={href({ estado: 'cerrados', tarjeta: cardFilter })}>{t(locale, 'plans.tab.closed')}</a>
          </div>
          {
            cards.length > 1 && (
              <div class="chips">
                <a class:list={['chip chip-button', !cardFilter && 'is-on']} href={href({ estado: tab === 'closed' ? 'cerrados' : '', })}>{t(locale, 'plans.filter.all')}</a>
                {cards.map(([id, name]) => (
                  <a class:list={['chip chip-button', cardFilter === id && 'is-on']} href={href({ estado: tab === 'closed' ? 'cerrados' : '', tarjeta: id })}>{name}</a>
                ))}
              </div>
            )
          }
        </div>

        {
          allTags.length > 0 && (
            <div class="chips" role="group" aria-label={t(locale, 'plans.filter.tag')}>
              <a class:list={['chip chip-button', !tagFilter && 'is-on']} href={href({ estado: tab === 'closed' ? 'cerrados' : '', tarjeta: cardFilter, etiqueta: '' })}>{t(locale, 'plans.filter.all')}</a>
              {allTags.map((tag) => (
                <a class:list={['chip chip-button', tagFilter === tag.id && 'is-on']} href={href({ estado: tab === 'closed' ? 'cerrados' : '', tarjeta: cardFilter, etiqueta: tag.id })}>{tag.name}</a>
              ))}
            </div>
          )
        }

        {
          shown.length === 0 ? (
            <section class="card">
              <p class="empty">{t(locale, 'plans.noneInTab')}</p>
            </section>
          ) : (
            groups.map((group) => {
              const summary = cardSummaryOf(group.cardId);
              return (
                <section class="card plan-group" aria-labelledby={`group-${group.cardId}`}>
                  <div class="plan-group-head">
                    <h2 id={`group-${group.cardId}`}>
                      <span class={`tone-dot tone-${tones.get(group.cardId) ?? 'navy'}`} aria-hidden="true"></span>
                      <a href={href({ estado: tab === 'closed' ? 'cerrados' : '', tarjeta: group.cardId })}>{group.cardName}</a>
                    </h2>
                    {tab === 'active' && summary && (
                      <span class="muted">
                        {tn(locale, 'plans.group.sub', summary.openPlans, { month: formatMinor(summary.thisMonthMinor, summary.currency, locale), remaining: formatMinor(summary.remainingBalanceMinor, summary.currency, locale) })}
                      </span>
                    )}
                  </div>
                  <div class="plan-cols" aria-hidden="true">
                    <span>{t(locale, 'plans.col.name')}</span>
                    <span>{t(locale, 'plans.col.progress')}</span>
                    <span class="num">{t(locale, 'plans.col.installment')}</span>
                    <span class="num">{t(locale, 'plans.col.remaining')}</span>
                    <span>{t(locale, 'plans.col.end')}</span>
                  </div>
                  <ul class="plan-rows">
                    {group.plans.map((plan) => (
                      <li>
                        <span class="plan-name">
                          <a href={`/app/planes/${plan.id}${accountFilter ? `?cuenta=${accountFilter}` : ''}`}>{plan.name}</a>
                          <small class="muted">{t(locale, `import.plan.type.${plan.type}`)}</small>
                          {(tagMap.get(plan.id) ?? []).map((tag) => <a class="chip chip-tag" href={href({ estado: tab === 'closed' ? 'cerrados' : '', tarjeta: cardFilter, etiqueta: tag.id })}>{tag.name}</a>)}
                          {plan.status !== 'active' && <span class:list={['badge', plan.status === 'review' && 'badge-warn', plan.status === 'settled_manual' && 'badge-off']}>{t(locale, `plans.status.${plan.status}`)}</span>}
                        </span>
                        <span class="plan-progress">
                          <Segments paid={plan.paidInstallments} total={plan.totalInstallments} />
                          <small class="muted">{t(locale, 'plans.segments', { paid: String(plan.paidInstallments), total: String(plan.totalInstallments) })}</small>
                        </span>
                        <span class="num plan-money" data-label={t(locale, 'plans.col.installment')}>{formatMinor(plan.installmentAmountMinor, plan.currency, locale)}</span>
                        <span class="num plan-money" data-label={t(locale, 'plans.col.remaining')}>{isOpen(plan) ? formatMinor(remainingBalanceMinor(plan), plan.currency, locale) : '—'}</span>
                        <span class="plan-end" data-label={t(locale, 'plans.col.end')}>{formatDate(endOf.get(plan.id)!, locale)}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })
          )
        }
        {canWrite && (
          <details class="card" id="balances" data-messages={JSON.stringify(balanceMessages)} data-currency={all[0]?.currency ?? workspace.defaultCurrency} data-locale={locale}>
            <summary><strong>{t(locale, 'balances.title')}</strong></summary>
            <p class="hint">{t(locale, 'balances.hint')}</p>
            <div id="balances-error" class="alert" role="alert" hidden />
            <div id="balances-done" class="alert ok" role="status" hidden />
            <form id="balances-form" class="form-grid" novalidate>
              <div class="field">
                <label for="b-account">{t(locale, 'balances.account')}</label>
                <select id="b-account" name="accountId">
                  {balanceAccounts.map(([id, name]) => <option value={id} selected={id === accountFilter}>{name}</option>)}
                </select>
              </div>
              <div class="field narrow">
                <label for="b-date">{t(locale, 'balances.asOf')}</label>
                <input id="b-date" name="asOf" type="date" required value={todayISO(Astro.locals.timeZone)} />
                <span class="field-error" data-error-for="asOf" />
              </div>
              <div class="field">
                <label for="b-files">{t(locale, 'balances.files')}</label>
                <input id="b-files" name="files" type="file" accept=".csv,text/csv" multiple required />
                <span class="field-error" data-error-for="files" />
              </div>
              <div class="form-actions"><button class="btn btn-auto" type="submit">{t(locale, 'balances.review')}</button></div>
            </form>
            <div id="balances-preview" hidden>
              <h3>{t(locale, 'balances.matches')}</h3>
              <div class="table-scroll">
                <table class="import-table">
                  <caption class="sr-only">{t(locale, 'balances.matches')}</caption>
                  <thead><tr><th scope="col">{t(locale, 'plans.col.name')}<Help topic="plans.col.name" /></th><th scope="col" class="num">{t(locale, 'balances.current')}<Help topic="balances.current" /></th><th scope="col" class="num">{t(locale, 'balances.bank')}<Help topic="balances.bank" /></th></tr></thead>
                  <tbody id="balances-rows"></tbody>
                </table>
              </div>
              <div id="balances-unmatched" hidden>
                <h3>{t(locale, 'balances.unmatched')}</h3>
                <p class="hint">{t(locale, 'balances.unmatchedHint')}</p>
                <ul id="balances-unmatched-list"></ul>
              </div>
              <button class="btn btn-auto" type="button" id="balances-apply">{t(locale, 'balances.apply')}</button>
            </div>
          </details>
        )}
      </>
    )
  }
</AppLayout>

<script>
  import '../../../scripts/plan-balances';
</script>

<style>
  .plans-free {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 1.5rem 2rem;
  }

  .plans-free h2 {
    margin: 0;
  }

  .freelist {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .freelist li {
    display: grid;
    grid-template-columns: 11rem 1rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: baseline;
  }

  .freelist-month {
    font-weight: 700;
  }

  .freelist-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--step);
    align-self: center;
  }

  .freelist-what {
    overflow-wrap: anywhere;
  }

  .freelist-amount {
    font-weight: 700;
    color: var(--good);
    white-space: nowrap;
  }

  .free-side {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .kv {
    display: grid;
  }

  .kv span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .kv strong {
    font-size: 1.2rem;
  }

  .free-ladder {
    grid-column: 1 / -1;
  }

  .free-ladder summary {
    font-weight: 700;
    cursor: pointer;
  }

  .plan-group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
  }

  .plan-group-head h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.05rem;
  }

  .plan-cols,
  .plan-rows li {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(7rem, 1.2fr) minmax(0, 0.8fr) minmax(0, 0.8fr) minmax(0, 0.9fr);
    gap: 0.75rem;
    align-items: center;
  }

  .plan-cols {
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
  }

  .plan-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan-rows li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .plan-rows li:last-child {
    border-bottom: 0;
  }

  .plan-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    min-width: 0;
  }

  .plan-name a:first-child {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .plan-name small {
    flex-basis: 100%;
    order: 1;
  }

  .plan-progress {
    display: grid;
    gap: 0.25rem;
  }

  .plan-progress small {
    font-size: 0.75rem;
  }

  .plan-money {
    font-weight: 700;
    white-space: nowrap;
  }

  .num {
    text-align: right;
  }

  .plan-end {
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .plans-free {
      grid-template-columns: minmax(0, 1fr);
    }

    .freelist li {
      grid-template-columns: 1rem minmax(0, 1fr) auto;
    }

    .freelist-month {
      grid-column: 1 / -1;
    }

    .plan-cols {
      display: none;
    }

    /* En el celular cada plan es una tarjeta: nombre, avance y tres datos con su etiqueta. */
    .plan-rows li {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .plan-name,
    .plan-progress {
      grid-column: 1 / -1;
    }

    .plan-rows [data-label] {
      display: grid;
      text-align: left;
      white-space: normal;
    }

    .plan-rows [data-label]::before {
      content: attr(data-label);
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--muted);
    }
  }
</style>
