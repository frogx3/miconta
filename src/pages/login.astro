---
import AuthLayout from '../layouts/AuthLayout.astro';
import { t, messagesFor } from '../i18n/messages';
import { getDb, isSignupAllowedByConfig } from '../lib/auth';
import { isSignupOpen } from '../lib/auth/hooks';

const { locale } = Astro.locals;
const { open } = await isSignupOpen(getDb(), isSignupAllowedByConfig());
const messages = messagesFor(locale, ['auth.']);
---

<AuthLayout title={t(locale, 'auth.login.title')} heading={t(locale, 'auth.login.heading')} lead={t(locale, 'auth.login.lead')}>
  <div id="error" class="alert" role="alert" tabindex="-1" hidden></div>
  <form id="login-form" data-messages={JSON.stringify(messages)} novalidate>
    <div class="field">
      <label for="email">{t(locale, 'auth.field.email')}</label>
      <input
        id="email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="next"
        aria-describedby="email-error"
        required
      />
      <span class="field-error" id="email-error"></span>
    </div>
    <div class="field">
      <label for="password">{t(locale, 'auth.field.password')}</label>
      <div class="password-wrap">
        <input id="password" name="password" type="password" autocomplete="current-password" enterkeyhint="go" aria-describedby="password-error" required />
        <button class="pw-toggle" type="button" data-pw-toggle="password" aria-pressed="false" aria-label={t(locale, 'auth.password.showLabel')}>
          {t(locale, 'auth.password.show')}
        </button>
      </div>
      <span class="field-error" id="password-error"></span>
    </div>
    <details class="forgot">
      <summary>{t(locale, 'auth.login.forgot')}</summary>
      <p class="hint">{t(locale, 'auth.login.forgotHelp')}</p>
    </details>
    <button class="btn" type="submit">{t(locale, 'auth.login.submit')}</button>
  </form>
  <p class="switch">
    {
      open ? (
        <>
          {t(locale, 'auth.login.noAccount')} <a href="/registro">{t(locale, 'auth.login.signupLink')}</a>
        </>
      ) : (
        t(locale, 'auth.login.noAccountClosed')
      )
    }
  </p>
</AuthLayout>

<script>
  import { authClient } from '../lib/auth/client';
  import { authErrorKey } from '../lib/auth/errors';
  import { clearAlert, clearOnInput, focusFirstOnDesktop, initPasswordToggles, setBusy, showAlert, validateRequired, type Messages } from '../scripts/auth-form';

  const form = document.querySelector<HTMLFormElement>('#login-form')!;
  const errorBox = document.querySelector<HTMLElement>('#error')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const email = form.querySelector<HTMLInputElement>('#email')!;
  const password = form.querySelector<HTMLInputElement>('#password')!;
  const messages = JSON.parse(form.dataset.messages!) as Messages;
  const idleText = button.textContent!.trim();

  initPasswordToggles(messages);
  clearOnInput(form);
  focusFirstOnDesktop(email);

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearAlert(errorBox);

    const invalid = validateRequired([
      { input: email, message: messages['auth.error.emailRequired']! },
      { input: password, message: messages['auth.error.passwordRequired']! },
    ]);
    if (invalid) {
      invalid.focus();
      return;
    }

    setBusy(form, button, true, messages['auth.working']!, idleText);
    const { error } = await authClient.signIn.email({ email: email.value.trim(), password: password.value });

    if (error) {
      setBusy(form, button, false, messages['auth.working']!, idleText);
      showAlert(errorBox, messages['auth.error.label']!, messages[authErrorKey(error)] ?? messages['auth.error.generic']!);
      return;
    }
    location.assign('/app');
  });
</script>
