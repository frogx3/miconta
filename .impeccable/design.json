  "narrative": {
    "northStar": "La escalera hacia la libertad",
    "overview": "Cada pago es un peldaño y el progreso se lee de un vistazo. Navy como tinta, dorado como marca de lo liberado, plano con líneas finas, Montserrat en todo.",
    "keyCharacteristics": [
      "Plano con líneas finas; sin sombras ni degradados.",
      "Navy como tinta y acción; dorado escaso, solo para progreso y \"liberado\".",
      "Montserrat en todo, cifras con numerales tabulares.",
      "Claro por defecto; oscuro profundo cuando el sistema lo pide.",
      "Acciones y objetivos táctiles pensados para una mano."
    ],
    "rules": [
      {
        "name": "The Gold Is a Step Rule",
        "body": "El dorado marca avance conseguido. Si aparece en más del 10% de una pantalla o decora algo sin progreso, sobra.",
        "section": "colors"
      },
      {
        "name": "The Ink-Not-Gold Text Rule",
        "body": "Ningún texto va en dorado sobre blanco; el dorado es relleno o borde.",
        "section": "colors"
      },
      {
        "name": "The Tabular Money Rule",
        "body": "Toda cantidad de dinero o fecha en columnas usa numerales tabulares.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "No hay sombras. Si algo necesita separarse, usa borde, superficie o espacio.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do poner la carga del mes y la fecha de libertad de pagos arriba de cada vista de planes.",
      "Do usar numerales tabulares para dinero y fechas.",
      "Do mostrar cada moneda por separado; nunca mezclarlas en un total.",
      "Do escribir en español de México, tuteando y sin jerga bancaria.",
      "Do mantener todo flujo clave usable a una mano en 375px de ancho."
    ],
    "donts": [
      "Don't usar dorado como color de texto sobre blanco.",
      "Don't añadir sombras, degradados ni efectos de vidrio.",
      "Don't usar rojo como tono general de la deuda; es solo para errores y acciones destructivas.",
      "Don't introducir una segunda tipografía; la jerarquía sale del peso.",
      "Don't usar estados que dependan solo del color."
